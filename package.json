{
  "name": "comment-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:native": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx --test --test-concurrency=1 'tests/**/*.test.ts' 'tests/**/*.test.mjs' 'contracts/tests/**/*.test.mjs'",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test-coverage-include='contracts/**' --test --test-concurrency=1 'tests/**/*.test.ts' 'tests/**/*.test.mjs' 'contracts/tests/**/*.test.mjs'",
    "test:integration": "node --import tsx --test --test-concurrency=1 'tests/integration/**/*.test.ts'",
    "test:performance": "node --import tsx --test --test-concurrency=1 'tests/performance/**/*.test.ts'",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.1",
    "octokit": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
