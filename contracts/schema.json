{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comment-lens.dev/contracts.schema.json",
  "title": "Comment Lens contracts v1",
  "type": "object",
  "$defs": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonNegative": { "type": "integer", "minimum": 0 },
    "date": { "type": "string", "format": "date-time" },
    "point": { "type": "object", "required": ["line0", "columnByte0"], "properties": { "line0": { "$ref": "#/$defs/nonNegative" }, "columnByte0": { "$ref": "#/$defs/nonNegative" } }, "additionalProperties": false },
    "span": { "type": "object", "required": ["startByte", "endByte", "start", "end", "endExclusive", "precision"], "properties": { "startByte": { "$ref": "#/$defs/nonNegative" }, "endByte": { "$ref": "#/$defs/nonNegative" }, "start": { "$ref": "#/$defs/point" }, "end": { "$ref": "#/$defs/point" }, "endExclusive": { "const": true }, "precision": { "enum": ["exact", "approximate"] } }, "additionalProperties": false },
    "diagnostic": { "type": "object", "required": ["path", "severity", "code", "message"], "properties": { "path": { "type": ["string", "null"], "minLength": 1 }, "severity": { "enum": ["warning", "error"] }, "code": { "enum": ["unsupported_language", "grammar_missing", "decode_failed", "binary_file", "file_too_large", "permission_denied", "parse_failed", "git_failed"] }, "message": { "type": "string", "minLength": 1, "maxLength": 2000 } }, "additionalProperties": false },
    "file": { "type": "object", "required": ["path", "discovery", "language", "status", "parser", "sizeBytes", "contentSha256", "encoding", "lineCount", "exclusionReason", "matchedRule", "parseErrorCount"], "properties": { "path": { "type": "string", "minLength": 1 }, "discovery": { "enum": ["tracked", "untracked", "explicit"] }, "language": { "type": ["string", "null"], "minLength": 1 }, "status": { "enum": ["parsed", "parsed_with_errors", "fallback", "excluded", "failed"] }, "parser": { "type": ["string", "null"], "enum": ["tree-sitter", "pygments", null] }, "sizeBytes": { "$ref": "#/$defs/nonNegative" }, "contentSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "encoding": { "type": ["string", "null"], "minLength": 1 }, "lineCount": { "type": ["integer", "null"], "minimum": 0 }, "exclusionReason": { "type": ["string", "null"], "minLength": 1 }, "matchedRule": { "type": ["string", "null"], "minLength": 1 }, "parseErrorCount": { "$ref": "#/$defs/nonNegative" } }, "additionalProperties": false },
    "symbol": { "type": "object", "required": ["kind", "name", "qualifiedName", "signature", "span"], "properties": { "kind": { "enum": ["module", "class", "struct", "function", "method", "property", "block"] }, "name": { "type": ["string", "null"], "minLength": 1 }, "qualifiedName": { "type": ["string", "null"], "minLength": 1 }, "signature": { "type": ["string", "null"], "minLength": 1 }, "span": { "$ref": "#/$defs/span" } }, "additionalProperties": false },
    "symbolContext": { "type": "object", "required": ["enclosing", "attachedTo", "resolution"], "properties": { "enclosing": { "anyOf": [{ "$ref": "#/$defs/symbol" }, { "type": "null" }] }, "attachedTo": { "anyOf": [{ "$ref": "#/$defs/symbol" }, { "type": "null" }] }, "resolution": { "enum": ["tree-sitter", "none"] } }, "additionalProperties": false },
    "blame": { "type": "object", "required": ["startLine0", "endLine0", "commit", "authorName", "authorEmail", "authoredAt", "source"], "properties": { "startLine0": { "$ref": "#/$defs/nonNegative" }, "endLine0": { "$ref": "#/$defs/nonNegative" }, "commit": { "type": ["string", "null"], "minLength": 1 }, "authorName": { "type": ["string", "null"], "minLength": 1 }, "authorEmail": { "type": ["string", "null"], "minLength": 1 }, "authoredAt": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }, "source": { "enum": ["commit", "worktree", "unavailable"] } }, "additionalProperties": false },
    "git": { "type": "object", "required": ["available", "primaryCommit", "blameSpans", "error"], "properties": { "available": { "type": "boolean" }, "primaryCommit": { "type": ["string", "null"], "minLength": 1 }, "blameSpans": { "type": "array", "items": { "$ref": "#/$defs/blame" } }, "error": { "type": ["string", "null"], "minLength": 1 } }, "additionalProperties": false },
    "finding": { "type": "object", "required": ["ruleId", "contribution", "evidence", "explanation"], "properties": { "ruleId": { "type": "string", "minLength": 1 }, "contribution": { "type": "number", "minimum": 0 }, "evidence": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null", "array"] } }, "explanation": { "type": "string", "minLength": 1, "maxLength": 2000 } }, "additionalProperties": false },
    "score": { "type": "object", "required": ["eligible", "priorityScore", "band", "ruleSetVersion", "findings"], "properties": { "eligible": { "type": "boolean" }, "priorityScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }, "band": { "enum": ["low", "review", "high", "protected"] }, "ruleSetVersion": { "type": "string", "minLength": 1 }, "findings": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/finding" } } }, "additionalProperties": false },
    "comment": { "type": "object", "required": ["commentId", "scanId", "path", "language", "kind", "placement", "rawText", "bodyText", "rawSpan", "bodySpan", "fragments", "tags", "parser", "symbol", "sourceContext", "git", "score"], "properties": { "commentId": { "$ref": "#/$defs/id" }, "scanId": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 }, "language": { "type": "string", "minLength": 1 }, "kind": { "enum": ["line", "block", "doc_line", "doc_block", "markup", "shebang", "preprocessor", "special", "unknown"] }, "placement": { "enum": ["file_header", "leading", "inline", "trailing", "standalone"] }, "rawText": { "type": "string", "minLength": 1, "maxLength": 65536 }, "bodyText": { "type": "string", "maxLength": 65536 }, "rawSpan": { "$ref": "#/$defs/span" }, "bodySpan": { "anyOf": [{ "$ref": "#/$defs/span" }, { "type": "null" }] }, "fragments": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/span" } }, "tags": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1 } }, "parser": { "enum": ["tree-sitter", "pygments"] }, "symbol": { "anyOf": [{ "$ref": "#/$defs/symbolContext" }, { "type": "null" }] }, "sourceContext": { "type": ["string", "null"], "maxLength": 8192 }, "git": { "$ref": "#/$defs/git" }, "score": { "$ref": "#/$defs/score" } }, "additionalProperties": false },
    "manifest": { "type": "object", "required": ["schemaVersion", "scanId", "repoId", "sourceMode", "headCommit", "worktreeFingerprint", "configHash", "extractorVersion", "parserVersions", "startedAt", "completedAt", "files", "diagnostics"], "properties": { "schemaVersion": { "$ref": "#/$defs/schemaVersion" }, "scanId": { "$ref": "#/$defs/id" }, "repoId": { "$ref": "#/$defs/id" }, "sourceMode": { "enum": ["worktree", "revision"] }, "headCommit": { "type": ["string", "null"], "minLength": 1 }, "worktreeFingerprint": { "type": "string", "minLength": 1 }, "configHash": { "$ref": "#/$defs/hash" }, "extractorVersion": { "type": "string", "minLength": 1 }, "parserVersions": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }, "startedAt": { "$ref": "#/$defs/date" }, "completedAt": { "$ref": "#/$defs/date" }, "files": { "type": "array", "items": { "$ref": "#/$defs/file" } }, "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } } }, "additionalProperties": false },
    "reviewStatus": { "enum": ["unreviewed", "keep", "rewrite", "delete", "unsure"] },
    "review": { "type": "object", "required": ["commentId", "status", "note", "updatedAt"], "properties": { "commentId": { "$ref": "#/$defs/id" }, "status": { "$ref": "#/$defs/reviewStatus" }, "note": { "type": ["string", "null"], "maxLength": 4000 }, "updatedAt": { "$ref": "#/$defs/date" } }, "additionalProperties": false },
    "chunk": { "type": "object", "required": ["schemaVersion", "scanId", "chunkId", "sequence", "totalChunks", "comments", "files", "diagnostics"], "properties": { "schemaVersion": { "$ref": "#/$defs/schemaVersion" }, "scanId": { "$ref": "#/$defs/id" }, "chunkId": { "$ref": "#/$defs/id" }, "sequence": { "$ref": "#/$defs/nonNegative" }, "totalChunks": { "type": "integer", "minimum": 1 }, "comments": { "type": "array", "items": { "$ref": "#/$defs/comment" } }, "files": { "type": "array", "items": { "$ref": "#/$defs/file" } }, "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } } }, "additionalProperties": false },
    "complete": { "type": "object", "required": ["schemaVersion", "scanId", "manifest", "commentCount", "fileCount", "chunkCount", "contentSha256"], "properties": { "schemaVersion": { "$ref": "#/$defs/schemaVersion" }, "scanId": { "$ref": "#/$defs/id" }, "manifest": { "$ref": "#/$defs/manifest" }, "commentCount": { "$ref": "#/$defs/nonNegative" }, "fileCount": { "$ref": "#/$defs/nonNegative" }, "chunkCount": { "type": "integer", "minimum": 1 }, "contentSha256": { "$ref": "#/$defs/hash" } }, "additionalProperties": false },
    "workerChunkResponse": { "type": "object", "required": ["schemaVersion", "accepted", "chunkId"], "properties": { "schemaVersion": { "$ref": "#/$defs/schemaVersion" }, "accepted": { "const": true }, "duplicate": { "type": "boolean" }, "chunkId": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
    "workerCompleteResponse": { "type": "object", "required": ["schemaVersion", "accepted", "status"], "properties": { "schemaVersion": { "$ref": "#/$defs/schemaVersion" }, "accepted": { "const": true }, "status": { "const": "complete" } }, "additionalProperties": false },
    "workerFailure": { "type": "object", "required": ["schemaVersion", "scanId", "reason"], "properties": { "schemaVersion": { "$ref": "#/$defs/schemaVersion" }, "scanId": { "$ref": "#/$defs/id" }, "reason": { "type": "string", "minLength": 1, "maxLength": 2000 } }, "additionalProperties": false },
    "workerFailureResponse": { "type": "object", "required": ["schemaVersion", "accepted", "status"], "properties": { "schemaVersion": { "$ref": "#/$defs/schemaVersion" }, "accepted": { "const": true }, "status": { "const": "failed" } }, "additionalProperties": false },
    "assessment": { "type": "object", "required": ["schemaVersion", "commentId", "providerId", "modelId", "promptVersion", "styleLabel", "confidence", "reasons", "suggestedRewrite", "assessedAt"], "properties": { "schemaVersion": { "$ref": "#/$defs/schemaVersion" }, "commentId": { "$ref": "#/$defs/id" }, "providerId": { "type": "string", "minLength": 1 }, "modelId": { "type": "string", "minLength": 1 }, "promptVersion": { "type": "string", "minLength": 1 }, "styleLabel": { "enum": ["ordinary", "template_like", "overexplained", "uncertain", "protected"] }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "reasons": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }, "suggestedRewrite": { "type": ["string", "null"], "maxLength": 65536 }, "assessedAt": { "$ref": "#/$defs/date" } }, "additionalProperties": false },
    "geminiAssessment": { "$ref": "#/$defs/assessment" },
    "assessmentRequest": { "type": "object", "required": ["schemaVersion", "scanId"], "properties": { "schemaVersion": { "$ref": "#/$defs/schemaVersion" }, "scanId": { "$ref": "#/$defs/id" }, "sourceContext": { "enum": ["comment_only", "comment_and_symbol", "comment_and_code"] } }, "additionalProperties": false },
    "commentQuery": { "type": "object", "required": ["schemaVersion", "scanId"], "properties": { "schemaVersion": { "$ref": "#/$defs/schemaVersion" }, "scanId": { "$ref": "#/$defs/id" }, "q": { "type": "string", "maxLength": 200 }, "status": { "$ref": "#/$defs/reviewStatus" }, "language": { "type": "string", "maxLength": 64 }, "kind": { "enum": ["line", "block", "doc_line", "doc_block", "markup", "shebang", "preprocessor", "special", "unknown"] }, "path": { "type": "string", "maxLength": 512 }, "minScore": { "type": "number", "minimum": 0, "maximum": 100 }, "maxScore": { "type": "number", "minimum": 0, "maximum": 100 }, "author": { "type": "string", "maxLength": 256 }, "protected": { "type": "boolean" }, "generated": { "type": "boolean" }, "license": { "type": "boolean" }, "todo": { "type": "boolean" }, "sort": { "enum": ["score", "path", "age", "status"] }, "page": { "type": "integer", "minimum": 1 }, "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 } }, "additionalProperties": false },
    "scanDiagnostic": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 128 }, "message": { "type": "string", "minLength": 1, "maxLength": 2000 } }, "additionalProperties": true },
    "scan": { "type": "object", "required": ["schemaVersion", "scanId", "repository", "ref", "resolvedCommit", "status", "commentCount", "fileCount", "chunkCount", "diagnostics", "createdAt", "completedAt"], "properties": { "schemaVersion": { "$ref": "#/$defs/schemaVersion" }, "scanId": { "$ref": "#/$defs/id" }, "repository": { "type": "string", "minLength": 1 }, "ref": { "type": "string", "minLength": 1 }, "resolvedCommit": { "type": ["string", "null"], "minLength": 1 }, "status": { "enum": ["queued", "running", "complete", "failed"] }, "commentCount": { "$ref": "#/$defs/nonNegative" }, "fileCount": { "$ref": "#/$defs/nonNegative" }, "chunkCount": { "$ref": "#/$defs/nonNegative" }, "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/scanDiagnostic" } }, "createdAt": { "$ref": "#/$defs/date" }, "completedAt": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] } }, "additionalProperties": false },
    "scanListQuery": { "type": "object", "required": ["schemaVersion", "repositoryId"], "properties": { "schemaVersion": { "$ref": "#/$defs/schemaVersion" }, "repositoryId": { "$ref": "#/$defs/id" }, "limit": { "type": "integer", "minimum": 1, "maximum": 50 } }, "additionalProperties": false },
    "scanList": { "type": "object", "required": ["schemaVersion", "scans"], "properties": { "schemaVersion": { "$ref": "#/$defs/schemaVersion" }, "scans": { "type": "array", "items": { "$ref": "#/$defs/scan" } } }, "additionalProperties": false }
  }
}
